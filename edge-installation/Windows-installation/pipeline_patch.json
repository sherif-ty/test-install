{
    "id": "node-info",
    "conf": {
      "output": "default",
      "streamtags": [],
      "groups": {},
      "asyncFuncTimeout": 1000,
      "functions": [
        {
          "filter": "true",
          "conf": {
            "add": [
              {
                "disabled": false,
                "name": "SubFleetName",
                "value": "__metadata.cribl.group"
              },
              {
                "disabled": false,
                "name": "Connection_IP",
                "value": "__metadata.os.interfaces.net1[0].address"
              },
              {
                "disabled": false,
                "name": "version",
                "value": "__metadata.cribl.version"
              },
              {
                "disabled": false,
                "name": "OS_type",
                "value": "'linux'"
              },
              {
                "disabled": false,
                "name": "total_CPU",
                "value": "__metadata.os.cpu_count"
              },
              {
                "disabled": false,
                "name": "total_memory",
                "value": "__metadata.os.memory"
              },
              {
                "disabled": false,
                "name": "domain",
                "value": "__metadata.env.userdomain"
              },
              {
                "disabled": false,
                "name": "hostname",
                "value": "host"
              }
            ],
            "remove": [
              "_host"
            ]
          },
          "id": "eval",
          "final": true
        }
      ],
      "description": ""
    }
}